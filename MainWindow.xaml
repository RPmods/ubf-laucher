<Window x:Class="UBFLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UBFLauncher.Controls"
        Title="UBF Launcher" Width="1080" Height="620" MinWidth="1080" MinHeight="620" MaxWidth="1080" MaxHeight="620"
        Icon="pack://application:,,,/UBFLauncher;component/Assets/logo.ico"
        WindowStyle="None" ResizeMode="NoResize" BorderThickness="0" BorderBrush="#FF080B0D" Background="#FF080B0D" Opacity="0"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UBFLauncher;component/Assets/TwitchMark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UBFLauncher;component/Assets/SocialMarks.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UBFLauncher;component/Assets/AudioMarks.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid x:Name="FallbackBackground" Background="#FF101619" />
        <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill"
                      ClipToBounds="True" MediaEnded="BackgroundVideo_MediaEnded" MediaFailed="BackgroundVideo_MediaFailed" IsHitTestVisible="False" />
        <Grid x:Name="BackgroundOverlay" IsHitTestVisible="False" Opacity="0.12">
            <Rectangle Fill="#260A0D10" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#40080B0D" Offset="0" />
                        <GradientStop Color="#10080B0D" Offset="0.57" />
                        <GradientStop Color="#520A0D10" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid x:Name="IdentityPanel" Width="458" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="55,0,0,0" IsHitTestVisible="False" Opacity="0" Panel.ZIndex="2">
            <Grid.RenderTransform><TranslateTransform x:Name="IdentityTransform" X="-28" /></Grid.RenderTransform>
            <Image x:Name="HeroGameLogo" Source="" Width="430" Height="242" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="WindowChrome" Height="46" VerticalAlignment="Top" MouseLeftButtonDown="Chrome_MouseLeftButtonDown" Panel.ZIndex="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="SettingsButton" Content="⚙" Width="34" Height="30" ToolTip="Configuración" Style="{StaticResource QuietButton}" Padding="0" Click="Settings_Click" />
                <Button Content="—" Width="34" Height="30" Margin="5,0,0,0" Style="{StaticResource QuietButton}" Padding="0" Click="Minimize_Click" />
                <Button Content="×" Width="34" Height="30" Margin="5,0,0,0" Style="{StaticResource QuietButton}" Padding="0" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,52,38,44">
            <Border x:Name="UserPanel" Width="400" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="23,22" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="2"
                    Background="#A2161B21" BorderBrush="#66849199" BorderThickness="1" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform x:Name="UserTransform" X="34" /></Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="TU PERFIL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBlock x:Name="WelcomeTitle" Text="Bienvenido" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock x:Name="UsernameLabel" Text="Nombre de usuario" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox x:Name="UserNameInput" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,7" FontSize="14"
                             KeyDown="UserNameInput_KeyDown" />
                    <TextBlock x:Name="NameError" Foreground="#FFFF8B82" FontSize="12" Margin="0,7,0,0" />
                    <Button x:Name="ContinueButton" Content="CONTINUAR" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,15,0,0" HorizontalAlignment="Stretch" Click="Continue_Click" />
                    <TextBlock x:Name="UsernameHint" Text="Tu nombre se guarda en este equipo." Foreground="#FF89949A" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Grid x:Name="GamePanel" Width="410" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform x:Name="GameTransform" X="34" /></Grid.RenderTransform>
                <Border Background="#A2161B21" BorderBrush="#66849199" BorderThickness="1" CornerRadius="10" Padding="21,20">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="GameSectionLabel" Text="EL JUEGO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="UNIVERSAL BREAKING FIGHTERS" Foreground="#FFB8C3C6" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="Wordmark" Text="UBF" Foreground="White" FontSize="38" FontWeight="Black" Margin="-2,6,0,-3" />
                        <Border Width="38" Height="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,6,0,13" />

                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}" Foreground="#FFD0D7D9" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MinHeight="18" />

                        <Border Background="#20232B31" BorderBrush="#3D7B8B91" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,13,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InstalledVersionLabel" Text="VERSIÓN INSTALADA" Foreground="#FF9BA7B4" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledGameVersion}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,6,0,0" Visibility="{Binding HasGameUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AvailableVersionLabel" Text="ACTUALIZACIÓN DISPONIBLE" Foreground="#FFFF8B82" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding AvailableGameVersion}" Foreground="#FFFFB2A8" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowOperationProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:AnimatedProgressBar Style="{StaticResource OperationProgressBar}" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                          IsIndeterminate="{Binding IsProgressIndeterminate}" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentFile}" Foreground="#FFB9C2C5" FontSize="10" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" Width="220" />
                                <TextBlock Text="{Binding ProgressText}" Foreground="#FFEEF2F3" FontSize="10" HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>

                        <Button x:Name="PrimaryButton" Content="{Binding PrimaryAction}" IsEnabled="{Binding CanUsePrimaryAction}" Style="{StaticResource PrimaryButton}"
                                Height="43" HorizontalAlignment="Stretch" Margin="0,15,0,0" Click="Primary_Click" />
                        <Button x:Name="LauncherUpdateButton" Content="ACTUALIZAR LAUNCHER" IsEnabled="{Binding CanVerify}" Style="{StaticResource QuietButton}" Height="34" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="LauncherUpdate_Click" />
                        <UniformGrid Columns="3" Margin="0,7,0,0">
                            <Button x:Name="VerifyButton" Content="VERIFICAR" IsEnabled="{Binding CanVerify}" Style="{StaticResource QuietButton}" Margin="0,0,3,0" Click="Verify_Click" />
                            <Button x:Name="FolderButton" Content="CARPETA" IsEnabled="{Binding CanVerify}" Style="{StaticResource QuietButton}" Margin="1,0,2,0" Click="ChangeFolder_Click" />
                            <Button x:Name="ChangeUserButton" Content="USUARIO" IsEnabled="{Binding CanVerify}" Style="{StaticResource QuietButton}" Margin="3,0,0,0" Click="ChangeUser_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel x:Name="SocialButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,18" Panel.ZIndex="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,18" Panel.ZIndex="4">
            <ToggleButton x:Name="VolumePopupToggle" Width="34" Height="32" ToolTip="Controles de audio" Background="#44232B31" BorderBrush="#667B8B91" BorderThickness="1"
                          Checked="VolumeToggle_Checked" Unchecked="VolumeToggle_Unchecked">
                <ToggleButton.Content><Image x:Name="VolumeIcon" Source="{StaticResource AudioOnMark}" Width="16" Height="16" Stretch="Uniform" /></ToggleButton.Content>
            </ToggleButton>
            <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumePopupToggle}" Placement="Top" AllowsTransparency="True" StaysOpen="False"
                   IsOpen="{Binding IsChecked, ElementName=VolumePopupToggle}">
                <Border Background="#EF10171A" BorderBrush="#557C8A8A" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Content="MUTE" Style="{StaticResource QuietButton}" Padding="9,7" Click="Mute_Click" />
                        <Slider x:Name="VolumeSlider" Width="126" Minimum="0" Maximum="1" Value="0.65" Margin="10,0,0,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock Text="{Binding UserName}" Foreground="#FFB1BCBB" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0" />
        </StackPanel>

        <Border x:Name="LauncherBrand" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,12,0,0" Padding="7,6" CornerRadius="8" BorderThickness="1" BorderBrush="#66849199" Panel.ZIndex="5" Background="#D9161B21">
            <StackPanel Orientation="Horizontal">
                <Border Width="31" Height="31" CornerRadius="5" Margin="0,0,8,0">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9B5CFF" Offset="0" /><GradientStop Color="#FFEA355C" Offset="1" /></LinearGradientBrush></Border.Background>
                    <Image x:Name="LauncherBrandIcon" Width="25" Height="25" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UBF  /  LAUNCHER" Foreground="White" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="LauncherBadge" Text="V1.0.17" Foreground="#FFB9C2C5" FontSize="9" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
