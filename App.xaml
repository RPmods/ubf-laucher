<Application x:Class="UBFLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UBFLauncher.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Color x:Key="AccentColor">#FFFF4F66</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9BA7B4" />
        <SolidColorBrush x:Key="PanelBrush" Color="#E9161B21" />

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FFE33C55" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.92" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="QuietButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#FFD5DDE0" />
            <Setter Property="Background" Value="#44232B31" />
            <Setter Property="BorderBrush" Value="#667B8B91" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Background" Value="#5511161A" />
            <Setter Property="BorderBrush" Value="#66849199" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#DD192026" />
            <Setter Property="BorderBrush" Value="#66849199" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F5F6" />
        </Style>

        <Style x:Key="OperationProgressBar" TargetType="{x:Type controls:AnimatedProgressBar}">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#314D5A60" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:AnimatedProgressBar}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#4D97A5AA" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" Background="Transparent" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFF8A69" Offset="0" />
                                            <GradientStop Color="#FFFF3F67" Offset="0.55" />
                                            <GradientStop Color="#FFAD6BFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Rectangle x:Name="ProgressShimmer" Opacity="0.28" Width="90" HorizontalAlignment="Left">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#CCFFFFFF" Offset="0.5" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                                <Border x:Name="IndeterminateIndicator" Width="104" HorizontalAlignment="Left" Visibility="Collapsed" CornerRadius="4" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FF8A69" Offset="0" />
                                            <GradientStop Color="#CCFF5D79" Offset="0.45" />
                                            <GradientStop Color="#FFFFE3D6" Offset="0.65" />
                                            <GradientStop Color="#00FF8A69" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
