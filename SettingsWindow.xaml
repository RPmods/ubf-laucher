<Window x:Class="UBFLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="560" Height="610" ResizeMode="NoResize"
        Icon="pack://application:,,,/UBFLauncher;component/Assets/logo.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#FF101416">
    <Border BorderBrush="#FF63313A" BorderThickness="1" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Configuración" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="Preferencias del launcher" Foreground="#FF9BA7B4" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="×" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Padding="0" Click="Close_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
                <StackPanel>
                    <TextBlock x:Name="AboutHeading" Text="Información" Foreground="#FFFF7581" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="AboutBody" Foreground="#FFE5E9EA" Margin="0,7,0,20" />
                    <TextBlock x:Name="LanguageLabel" Text="Idioma" Foreground="White" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguagePicker" Height="38" Margin="0,7,0,18" Padding="8,5" SelectedValuePath="Tag" SelectionChanged="LanguagePicker_SelectionChanged">
                        <ComboBoxItem Content="Español" Tag="es" /><ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <TextBlock x:Name="PathLabel" Text="Carpeta de instalación del juego" Foreground="White" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPath" Height="38" Padding="9,8" VerticalContentAlignment="Center" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="EXAMINAR" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Click="Browse_Click" />
                    </Grid>
                    <CheckBox x:Name="AutomaticUpdates" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="AutomaticHint" Foreground="#FF9BA7B4" TextWrapping="Wrap" Margin="0,6,0,17" />
                    <Button x:Name="VerifyGameButton" Content="VERIFICAR ARCHIVOS DEL JUEGO" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="VerifyGame_Click" />
                    <Button x:Name="CheckUpdateButton" Content="BUSCAR ACTUALIZACIÓN DEL LAUNCHER" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Margin="0,9,0,0" Click="CheckUpdate_Click" />
                    <TextBlock x:Name="UpdateResult" Foreground="#FFFFA1AA" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="CERRAR" Style="{StaticResource QuietButton}" Click="Close_Click" />
                <Button x:Name="SaveButton" Content="GUARDAR" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Padding="20,10" FontSize="13" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
