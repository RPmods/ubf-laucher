<Window x:Class="UBFLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="548" Height="542" ResizeMode="NoResize"
        Icon="pack://application:,,,/UBFLauncher;component/Assets/logo.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#FF0E1316"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#C9161D22" />
            <Setter Property="BorderBrush" Value="#5277878E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFF7581" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF0F3F4" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9BA7B4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF613139" BorderThickness="1" CornerRadius="10" Padding="14" Background="#F00E1316">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D9161D22" BorderBrush="#5677878E" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" VerticalAlignment="Center" CornerRadius="8" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF9B5CFF" Offset="0" />
                                <GradientStop Color="#FFEA355C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="pack://application:,,,/UBFLauncher;component/Assets/logo.ico" Width="31" Height="31" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Configuración" Foreground="White" FontFamily="Bahnschrift SemiBold" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Text="Preferencias del launcher" Foreground="#FFAEB9BD" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Width="30" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource QuietButton}" Padding="0" FontSize="17" Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,10" Padding="0,0,5,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsCard}" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="AboutHeading" Text="Información" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="AboutBody" Foreground="#FFDCE3E4" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock x:Name="InstallationHeading" Text="INSTALACIÓN Y ACTUALIZACIONES" Style="{StaticResource SectionLabel}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="156" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="LanguageLabel" Text="Idioma" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="LanguageHint" Text="Elige cómo se muestran los textos." Style="{StaticResource FieldHint}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="LanguagePicker" Grid.Column="1" Height="31" Padding="8,3" VerticalContentAlignment="Center"
                                          SelectedValuePath="Tag" SelectionChanged="LanguagePicker_SelectionChanged">
                                    <ComboBoxItem Content="Español" Tag="es" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="#335F6C72" Margin="0,11,0,10" />

                            <TextBlock x:Name="PathLabel" Text="Carpeta de instalación del juego" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPath" Height="34" Padding="10,6" VerticalContentAlignment="Center" FontSize="11" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="EXAMINAR" Height="34" Margin="7,0,0,0"
                                        Style="{StaticResource QuietButton}" Padding="11,6" Click="Browse_Click" />
                            </Grid>

                            <Border Height="1" Background="#335F6C72" Margin="0,11,0,9" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <CheckBox x:Name="AutomaticUpdates" Foreground="White" FontSize="11" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AutomaticHint" Style="{StaticResource FieldHint}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="#2BFF4F66" VerticalAlignment="Top">
                                    <TextBlock Text="↻" Foreground="#FFFF8D98" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock x:Name="MaintenanceHeading" Text="MANTENIMIENTO" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="MaintenanceHint" Text="Revisa los archivos locales y las novedades del launcher." Style="{StaticResource FieldHint}" Margin="0,3,0,0" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button x:Name="VerifyGameButton" Content="VERIFICAR JUEGO" Height="34" Style="{StaticResource QuietButton}"
                                        Margin="0,0,4,0" Padding="8,6" Click="VerifyGame_Click" />
                                <Button x:Name="CheckUpdateButton" Content="BUSCAR ACTUALIZACIÓN" Height="34" Style="{StaticResource QuietButton}"
                                        Margin="4,0,0,0" Padding="8,6" Click="CheckUpdate_Click" />
                            </UniformGrid>
                            <TextBlock x:Name="UpdateResult" Foreground="#FFFFA1AA" FontSize="10" TextWrapping="Wrap" MinHeight="14" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Border Height="1" VerticalAlignment="Top" Background="#3B6C7A80" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="CancelButton" Content="CERRAR" Height="33" Style="{StaticResource QuietButton}" Padding="15,7" Click="Close_Click" />
                    <Button x:Name="SaveButton" Content="GUARDAR CAMBIOS" Height="33" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="16,7" FontSize="11" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
