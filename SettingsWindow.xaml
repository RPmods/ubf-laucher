<Window x:Class="UBFLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="520" Height="555" ResizeMode="NoResize"
        Icon="pack://application:,,,/UBFLauncher;component/Assets/logo.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#FF101416"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="#FF63313A" BorderThickness="1" Padding="22" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Configuración" Foreground="White" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="Preferencias del launcher" Foreground="#FF9BA7B4" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="×" Width="32" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Padding="0" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,16">
                <StackPanel>
                    <Border Background="#8E192027" BorderBrush="#487A8990" BorderThickness="1" CornerRadius="7" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="AboutHeading" Text="Información" Foreground="#FFFF7581" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="AboutBody" Foreground="#FFE5E9EA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#8E192027" BorderBrush="#487A8990" BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LanguageLabel" Text="Idioma" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox x:Name="LanguagePicker" Height="36" Margin="0,6,0,13" Padding="8,4" SelectedValuePath="Tag" SelectionChanged="LanguagePicker_SelectionChanged">
                                <ComboBoxItem Content="Español" Tag="es" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                            <TextBlock x:Name="PathLabel" Text="Carpeta de instalación del juego" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPath" Height="36" Padding="9,7" VerticalContentAlignment="Center" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="EXAMINAR" Margin="7,0,0,0" Style="{StaticResource QuietButton}" Padding="12,7" Click="Browse_Click" />
                            </Grid>
                            <CheckBox x:Name="AutomaticUpdates" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="AutomaticHint" Foreground="#FF9BA7B4" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#8E192027" BorderBrush="#487A8990" BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="MANTENIMIENTO" Foreground="#FFFF7581" FontSize="10" FontWeight="Bold" />
                            <UniformGrid Columns="2" Margin="0,9,0,0">
                                <Button x:Name="VerifyGameButton" Content="VERIFICAR ARCHIVOS DEL JUEGO" Style="{StaticResource QuietButton}" Margin="0,0,4,0" Padding="8,8" Click="VerifyGame_Click" />
                                <Button x:Name="CheckUpdateButton" Content="BUSCAR ACTUALIZACIÓN DEL LAUNCHER" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Padding="8,8" Click="CheckUpdate_Click" />
                            </UniformGrid>
                            <TextBlock x:Name="UpdateResult" Foreground="#FFFFA1AA" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="CERRAR" Style="{StaticResource QuietButton}" Padding="16,9" Click="Close_Click" />
                <Button x:Name="SaveButton" Content="GUARDAR" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="18,9" FontSize="12" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
